# Sao chép file này thành .env rồi điền thông tin. File .env đã được git bỏ qua.

# Tài khoản đăng nhập hoadondientu.gdt.gov.vn (thường là MST + mật khẩu CQT cấp)
GDT_USERNAME=
GDT_PASSWORD=
# Hoặc dán sẵn token JWT lấy từ trình duyệt (F12 > Network > header Authorization) để bỏ qua đăng nhập
GDT_TOKEN=

# Thư mục kết quả (Excel, XML, JSON)
OUTPUT_DIR=output

# Mạng
PAGE_SIZE=50
REQUEST_DELAY_MS=600
XML_WORKERS=3
HTTP_TIMEOUT_SECONDS=90
# Proxy nếu máy chủ bị chặn IP (vd: http://127.0.0.1:8080)
PROXY_URL=
VERIFY_SSL=true
BROWSER_USER_AGENT=

# Xuất sang MISA SME: tài khoản mặc định điền sẵn trong file nhập khẩu (sửa được trong Excel)
MISA_TK_CHI_PHI=642
MISA_TK_CONG_NO=331
MISA_TK_THUE=1331
# Mã nhóm HHDV mua vào trong MISA (mặc định 1)
MISA_NHOM_HHDV=1
# Thanh toán cho hóa đơn mua vào: auto = hóa đơn của ngân hàng -> ủy nhiệm chi, TK 1121;
# hóa đơn mua hàng khác -> tiền mặt, TK 1111. Hoặc 0 (chưa thanh toán, TK 331), 1, 2, 3, 4 cho mọi hóa đơn.
MISA_THANH_TOAN=auto
MISA_TK_TIEN_MAT=1111
MISA_TK_NGAN_HANG=1121
# Từ khóa nhận ra người bán là ngân hàng (không phân biệt dấu, hoa thường), cách nhau bởi dấu phẩy
MISA_TU_KHOA_NGAN_HANG=ngan hang,bank
# Mẫu nhập khẩu MISA: 2020 = MISA SME 2020 R3 (38 cột, mặc định); moi = mẫu 39 cột có cột "Tỷ lệ tính thuế";
# hoặc đường dẫn tới file mẫu .xlsx của đơn vị (mở mẫu .xls bằng Excel, Save As .xlsx)
MISA_MAU=2020
# Bán ra: 1 = thu tiền mặt (TK Nợ 1111, mặc định), 0 = chưa thu tiền (TK Nợ 131), 2 = chuyển khoản (TK Nợ 1121)
MISA_BAN_THANH_TOAN=1
# TK doanh thu (5113 dịch vụ, 5111 hàng hóa), TK thuế GTGT đầu ra, TK phải thu khách hàng
MISA_TK_DOANH_THU=5113
MISA_TK_THUE_DAU_RA=33311
MISA_TK_PHAI_THU=131

# Bảng kê 01 giảm thuế GTGT (NQ142): lập theo quy (mặc định) hoặc thang
BANG_KE_KY=quy
